# MySQL connection used by the Express API.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hotelbooking_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=hotelbooking

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- YOUPI PG V2 Payment Gateway -------------------------------------------
# Payment API service URL (YOUPI PG runs on port 6100 by default)
YOUPI_PG_API_URL=http://localhost:6100

# Checkout portal URL (YOUPI PG checkout UI runs on port 7000 by default)
YOUPI_PG_CHECKOUT_URL=http://localhost:7000

# Merchant ID from YOUPI PG merchant admin (port 6001)
# Default dev merchant: 00000000-0000-0000-0000-000000000001
YOUPI_PG_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Webhook secret — copy from YouPI-PG-main/data/.secrets/coin_store_webhook_secret
# (or the secret assigned to your merchant via the YOUPI PG admin panel)
YOUPI_PG_WEBHOOK_SECRET=your-youpi-webhook-secret-here

# Return URL — YOUPI PG redirects here after checkout (must match your React route)
# Format: <base_url>/confirmation  (bookingId is appended automatically)
YOUPI_PG_RETURN_URL=http://localhost:3000/confirmation
