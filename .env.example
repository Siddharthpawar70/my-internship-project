# Server configuration
PORT=3000
NODE_ENV=development

# Admin Initial Credentials (seeded on first run if no admin exists)
ADMIN_INITIAL_EMAIL=admin@stayaura.com
ADMIN_INITIAL_PASSWORD=Admin@StayAura2026!

# Allowed Frontend URL (CORS origin for split deployments like Vercel frontend + Render backend)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Frontend API Base URL (leave blank for local monolithic dev; set on Vercel to point to your backend)
# VITE_API_URL=https://your-backend-api.onrender.com

# MySQL connection (optional; if omitted or fails to connect, local SQLite is used automatically)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hotelbooking_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=hotelbooking

# Payment Gateway (YOUPI PG V2)
YOUPI_PG_API_URL=http://localhost:6100
YOUPI_PG_CHECKOUT_URL=http://localhost:7000
YOUPI_PG_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_PG_WEBHOOK_SECRET=your-youpi-webhook-secret-here
YOUPI_PG_RETURN_URL=http://localhost:3000/confirmation
