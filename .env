# Server configuration
PORT=3000
NODE_ENV=development

# Admin Initial Credentials (seeded on startup if no admin exists)
ADMIN_INITIAL_EMAIL=admin@stayaura.com
ADMIN_INITIAL_PASSWORD=Admin@StayAura2026!

# MySQL connection used by the Express API.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=hotelbooking_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=hotelbooking

# Payment Gateway (YOUPI PG V2)
YOUPI_PG_API_URL=http://localhost:6100
YOUPI_PG_CHECKOUT_URL=http://localhost:7000
YOUPI_PG_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_PG_WEBHOOK_SECRET=youpi-webhook-secret-stayaura-2026
YOUPI_PG_RETURN_URL=http://localhost:3000/confirmation

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
